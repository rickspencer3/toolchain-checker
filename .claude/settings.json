{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "WebSearch",
      "WebFetch",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(python3 * | tee *)",
      "Bash(python * | tee *)",
      "Bash(tee *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(date *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(jq *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(uname *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(fdisk *)",
      "Bash(reboot)",
      "Bash(shutdown *)",
      "Bash(poweroff)"
    ]
  }
}
